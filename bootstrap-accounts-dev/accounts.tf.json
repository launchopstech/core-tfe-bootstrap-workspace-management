{
  "locals": {
    "accounts": {
      "test-client-dev": {
        "account_id": "889851937279",
        "client_id": "test-client",
        "account_name": "test.dev",
        "env": "dev",
        "product_name": "platform",
        "region": "us-east-1",
        "enable_aws_preflight": false,
        "security_tier": "high",
        "vcs_repo_identifier": "bomatronix/core-tfe-bootstrap-workspace-management",
        "service_vcs_repo_identifier": "bomatronix/core-tfe-bootstrap-workspace-management",
        "working_directory": "workspaces/account-bootstrap",
        "services": [
          "account-bootstrap",
          "secure-baseline",
          "vpc",
          "rds",
          "dns",
          "waf",
          "iam",
          "lambda",
          "api"
        ],
        "service_workspace_ownership": {
          "waf": "client",
          "iam": "client"
        },
        "service_workspace_variables": {
          "vpc": {
            "cidr_block": "10.0.0.0/16",
            "azs": ["us-east-1a", "us-east-1b"],
            "private_subnets": ["10.0.1.0/24", "10.0.2.0/24"],
            "public_subnets": ["10.0.101.0/24", "10.0.102.0/24"],
            "database_subnets": ["10.0.201.0/24", "10.0.202.0/24"]
          },
          "secure-baseline": {
            "kms_key_arn":         "arn:aws:kms:us-east-1:889851937279:key/7a915c50-1807-469e-b15d-7b4d1e6a3ca7",
            "enable_config":       false,
            "enable_guardduty":    false,
            "enable_security_hub": false
          },
          "rds": {
            "kms_key_arn": "arn:aws:kms:us-east-1:889851937279:key/7a915c50-1807-469e-b15d-7b4d1e6a3ca7",
            "instance_class": "db.t4g.small",
            "allocated_storage": 20,
            "max_allocated_storage": 0,
            "backup_retention_days": 7,
            "deletion_protection": false,
            "enable_performance_insights": false,
            "enable_enhanced_monitoring": false
          },
          "dns": {
            "dns_config_json": {
              "zone_name": "dev.mindrithm.app",
              "comment": "Delegated development public zone for API custom domains"
            }
          },
          "waf": {
            "waf_config_json": {
              "default_action": "allow",
              "scope": "REGIONAL",
              "attachment": {
                "mode": "target"
              },
              "logging": {
                "enabled": true,
                "retention_days": 30,
                "redacted_headers": ["authorization"]
              },
              "rate_rules": {
                "global": {
                  "priority": 200,
                  "limit": 2000,
                  "aggregate_key_type": "IP",
                  "action": "block"
                }
              }
            }
          },
          "iam": {
            "iam_config_json": {
              "oidc": {
                "issuer_url": "https://token.actions.githubusercontent.com",
                "client_id_list": ["sts.amazonaws.com"],
                "thumbprint_list": ["6938fd4d98bab03faadb97b34396831e3780aea1"],
                "roles": {
                  "artifact_publisher": {
                    "role_name_suffix": "artifact-publisher",
                    "subject_claims": [
                      "repo:bomatronix/core-tfe-bootstrap-workspace-management:*",
                      "repo:bomatronix/forge-core:environment:development"
                    ],
                    "inline_policy_json": {
                      "Version": "2012-10-17",
                      "Statement": [
                        {
                          "Sid": "ListArtifactBuckets",
                          "Effect": "Allow",
                          "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
                          "Resource": ["arn:aws:s3:::test-client-dev-api-code", "arn:aws:s3:::test-client-dev-lambda-code"]
                        },
                        {
                          "Sid": "ManageArtifactObjects",
                          "Effect": "Allow",
                          "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
                          "Resource": ["arn:aws:s3:::test-client-dev-api-code/*", "arn:aws:s3:::test-client-dev-lambda-code/*"]
                        },
                        {
                          "Sid": "UseArtifactKmsKey",
                          "Effect": "Allow",
                          "Action": ["kms:Decrypt", "kms:Encrypt", "kms:GenerateDataKey", "kms:DescribeKey"],
                          "Resource": ["arn:aws:kms:us-east-1:889851937279:key/7a915c50-1807-469e-b15d-7b4d1e6a3ca7"]
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "lambda": {
            "lambda_config_json": {
              "name": "test-worker",
              "function_name_suffix": "test-worker",
              "package": {
                "bucket": "test-client-dev-lambda-code",
                "key": "lambda/test-worker-v0.1.0.zip",
                "create_bucket": true,
                "upload_seed_code": true
              },
              "runtime": {
                "handler": "seed_handler.handler",
                "runtime": "python3.12"
              },
              "performance": {
                "memory_mb": 256,
                "timeout_seconds": 30
              },
              "environment": {
                "LOG_LEVEL": "debug"
              },
              "network": {
                "enabled": true
              },
              "logging": {
                "retention_days": 30
              },
              "iam": {
                "additional_policy_json": ""
              }
            }
          },
          "api": {
            "api_config_json": {
              "gateway": {
                "enabled": true,
                "cors": {
                  "allowed_origins": ["*"]
                },
                "stage": {
                  "name": "v1"
                },
                "waf": {
                  "enabled": true
                },
                "custom_domains": {
                  "primary": {
                    "domain_name": "api.dev.mindrithm.app",
                    "base_path": ""
                  }
                },
                "authorizers": {
                  "token": {
                    "lambda_key": "authorizer",
                    "auth_providers": {
                      "okta": {
                        "issuer_url": "https://dev-test.okta.com",
                        "audiences": ["api://default"]
                      }
                    },
                    "default_auth_provider": "okta"
                  }
                },
                "routes": {
                  "proxy": {
                    "path_part": "{proxy+}",
                    "methods": ["ANY"],
                    "integration_key": "crud",
                    "authorizer_key": "token"
                  },
                  "presign": {
                    "path_part": "presign",
                    "methods": ["ANY"],
                    "integration_key": "presign",
                    "authorizer_key": "token"
                  }
                }
              },
              "lambdas": {
                "crud": {
                  "name": "api-crud",
                  "seed": "seed_handler",
                  "upload_seed_code": true,
                  "function_name_suffix": "api-crud",
                  "handler": "authorizer.handler",
                  "memory_mb": 256,
                  "timeout_seconds": 30,
                  "runtime": "python3.12",
                  "needs_vpc": true,
                  "needs_db": true,
                  "needs_uploads": false
                },
                "presign": {
                  "name": "api-presign",
                  "seed": "seed_handler",
                  "upload_seed_code": true,
                  "function_name_suffix": "api-presign",
                  "handler": "seed_handler.handler",
                  "memory_mb": 128,
                  "timeout_seconds": 10,
                  "runtime": "python3.12",
                  "needs_vpc": false,
                  "needs_db": false,
                  "needs_uploads": true
                },
                "authorizer": {
                  "name": "api-authorizer",
                  "seed": "seed_authorizer",
                  "upload_seed_code": false,
                  "function_name_suffix": "api-authorizer",
                  "handler": "authorizer.handler",
                  "memory_mb": 128,
                  "timeout_seconds": 10,
                  "runtime": "python3.12",
                  "needs_vpc": false,
                  "needs_db": false,
                  "needs_uploads": false
                }
              },
              "artifacts": {
                "bucket": "test-client-dev-api-code",
                "create_bucket": true,
                "key_prefix": "api",
                "upload_seed_code": false,
                "version": "v0.1.0"
              },
              "database": {
                "proxy_enabled": true,
                "iam_username": "app"
              },
              "uploads": {
                "enabled": true
              }
            }
          }
        }
      }
    }
  }
}
